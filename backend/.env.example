# Postgres connection (async driver — used by both the app and Alembic)
DATABASE_URL=postgresql+asyncpg://architect:architect@localhost:5434/architect
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173
APP_ENV=local

# Claude — get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000
LLM_MAX_RETRIES=2
