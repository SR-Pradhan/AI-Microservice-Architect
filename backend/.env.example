# Postgres connection (async driver — used by both the app and Alembic)
DATABASE_URL=postgresql+asyncpg://architect:architect@localhost:5434/architect
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5180
APP_ENV=local

# Which provider generates the stages: "anthropic" or "gemini"
LLM_PROVIDER=gemini

# Google Gemini — free key from https://aistudio.google.com/apikey (no card required).
# If your key cannot use this model, check https://aistudio.google.com/rate-limit for what it can,
# and change GEMINI_MODEL accordingly.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Claude — paid, get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000
LLM_MAX_RETRIES=2
